# Server & Database Configuration
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/trustguard
MONGO_DB_NAME=trustguard
JWT_SECRET=trustguard-local-dev-secret
JWT_TTL=7d

# NodeMailer SMTP Configuration
# Provide your SMTP credentials below to send real alert emails.
# Examples:
# Gmail:       SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=your_email@gmail.com, SMTP_PASS=your_app_password
# Mailtrap:    SMTP_HOST=sandbox.smtp.mailtrap.io, SMTP_PORT=2525, SMTP_SECURE=false, SMTP_USER=..., SMTP_PASS=...
# Office365:   SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TrustGuard Security Engine" <security-alerts@trustguard.gov.in>
SECURITY_ALERT_EMAIL=security-admin@trustguard.gov.in
ENABLE_EMAIL_ALERTS=true

# Trust Engine Configurable Thresholds
# Trust score >= 80: NORMAL (No security email)
# Trust score 60-79: LOW RISK (Limited monitoring)
# Trust score 40-59: SUSPICIOUS (Trigger security alert email)
# Trust score 20-39: HIGH RISK (Trigger high-priority security email)
# Trust score < 20: CRITICAL (Trigger critical security email & session termination)
TRUST_THRESHOLD_NORMAL_MIN=80
TRUST_THRESHOLD_LOW_RISK_MIN=60
TRUST_THRESHOLD_SUSPICIOUS_MIN=40
TRUST_THRESHOLD_HIGH_RISK_MIN=20

# Alert Deduplication & Cooldown Configuration
TRUST_SIGNIFICANT_DROP_THRESHOLD=20
ALERT_COOLDOWN_MINUTES=10
ALERT_ON_LOW_RISK=false
ALERT_ON_SUSPICIOUS=true
ALERT_ON_HIGH_RISK=true
ALERT_ON_CRITICAL=true

# ML Isolation Forest Microservice (FastAPI + Scikit-Learn)
ML_SERVICE_URL=http://127.0.0.1:8000/predict
ML_TIMEOUT_MS=1500
ML_SCORE_WEIGHT=0.25
