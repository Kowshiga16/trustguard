# Server & Database Configuration
PORT=3000
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/trustguard
MONGO_DB_NAME=trustguard
JWT_SECRET=your_jwt_secret_key_here
JWT_TTL=7d

# CORS & Client URL Configuration
CLIENT_URL=https://your-frontend-domain.onrender.com

# Target Demo Recipient for Step-Up Verification OTPs (Configured in Render environment variables)
DEMO_OTP_EMAIL=
SECURITY_ALERT_EMAIL=
ENABLE_EMAIL_ALERTS=true

# Production Transactional Email: Brevo HTTPS API (Recommended for Render where ports 25, 465, 587 are blocked)
# Get a free API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Local Development SMTP Configuration (NodeMailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TrustGuard Zero Trust Security" <security@trustguard.gov.in>

# Trust Engine Configurable Thresholds
# Trust score >= 80: NORMAL (No security challenge)
# Trust score 60-79: LOW RISK (Continuous monitoring)
# Trust score 40-59: SUSPICIOUS (Identity challenge / OTP triggered)
# Trust score 20-39: HIGH RISK (Read-only mode enforced)
# Trust score < 20: CRITICAL (Session blocked & access revoked)
TRUST_THRESHOLD_NORMAL_MIN=80
TRUST_THRESHOLD_LOW_RISK_MIN=60
TRUST_THRESHOLD_SUSPICIOUS_MIN=40
TRUST_THRESHOLD_HIGH_RISK_MIN=20

# Alert Deduplication & Cooldown Configuration
TRUST_SIGNIFICANT_DROP_THRESHOLD=20
ALERT_COOLDOWN_MINUTES=10
ALERT_ON_LOW_RISK=false
ALERT_ON_SUSPICIOUS=true
ALERT_ON_HIGH_RISK=true
ALERT_ON_CRITICAL=true

# ML Isolation Forest Microservice (Optional fallback; Node.js embedded engine runs automatically if offline)
ML_SERVICE_URL=http://127.0.0.1:8000/predict
ML_TIMEOUT_MS=1500
ML_SCORE_WEIGHT=0.25

# ----------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client)
# Note: Vite compiles these into static client bundles at build time.
# Never expose backend secrets (SMTP passwords, JWT secrets) in VITE_ variables!
# ----------------------------------------------------
# If the frontend is hosted on the same origin as the backend (monolith build), leave blank:
# VITE_API_BASE_URL=
# If frontend is deployed separately on a distinct domain (e.g. Render Static Site):
VITE_API_BASE_URL=https://trustguard-2jfi.onrender.com

